{
  "name": "maolauncher",
  "productName": "MaoLauncher",
  "version": "0.1.12",
  "description": "MaoPickMe Minecraft launcher",
  "author": "MaoPickMe",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "postinstall": "node fix-deps.cjs"
  },
  "dependencies": {
    "@xmcl/core": "2.16.3",
    "@xmcl/installer": "6.3.7",
    "electron-updater": "6.8.11",
    "extract-zip": "2.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "playwright": "latest"
  },
  "build": {
    "appId": "ru.maopickme.launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "game.cjs",
      "ping.cjs",
      "release.json",
      "package.json",
      "ui/**/*",
      "assets/**/*",
      "mods.cjs",
      "mods-manifest.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MaoLauncher",
      "artifactName": "MaoLauncher-Setup-${version}.exe"
    }
  },
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "2.10.0"
    }
  }
}
