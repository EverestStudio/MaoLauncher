<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MaoLauncher-Setup</AssemblyName>
    <ApplicationIcon>../MaoLauncher/src/assets/mao-icon.ico</ApplicationIcon>
    <RootNamespace>MaoLauncher.Setup</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="installer.html"
                      LogicalName="MaoLauncher.Setup.installer.html" />
    <EmbeddedResource Include="..\MaoLauncher\src\assets\background.mp4"
                      Link="background.mp4"
                      LogicalName="MaoLauncher.Setup.background.mp4" />
    <EmbeddedResource Include="..\MaoLauncher\src\assets\background_main.jpg"
                      Link="background_main.jpg"
                      LogicalName="MaoLauncher.Setup.background_main.jpg" />
    <EmbeddedResource Include="../MaoLauncher/src/assets/mao-icon.ico"
                      Link="mao-icon.ico"
                      LogicalName="MaoLauncher.Setup.mao-icon.ico" />
    <EmbeddedResource Include="../MaoLauncher/src/assets/mao-icon.png"
                      Link="mao-icon.png"
                      LogicalName="MaoLauncher.Setup.mao-icon.png" />
  </ItemGroup>
</Project>