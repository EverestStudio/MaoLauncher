<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MaoLauncher-Setup</AssemblyName>
    <RootNamespace>MaoLauncher.Setup</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\MaoLauncher\src\assets\mao-banner.png"
                      Link="mao-banner.png"
                      LogicalName="MaoLauncher.Setup.mao-banner.png" />
  </ItemGroup>
</Project>