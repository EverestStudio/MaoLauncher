<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MaoLauncher-Setup</AssemblyName>
    <ApplicationIcon>../MaoLauncherNew/assets/icon.ico</ApplicationIcon>
    <RootNamespace>MaoLauncher.Setup</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="installer.html"
                      LogicalName="MaoLauncher.Setup.installer.html" />
    <EmbeddedResource Include="../MaoLauncherNew/assets/backgrounds/scene-1.png"
                      Link="background_main.jpg"
                      LogicalName="MaoLauncher.Setup.background_main.jpg" />
    <EmbeddedResource Include="../MaoLauncherNew/assets/icon.ico"
                      Link="mao-icon.ico"
                      LogicalName="MaoLauncher.Setup.mao-icon.ico" />
    <EmbeddedResource Include="../MaoLauncherNew/assets/icon.png"
                      Link="mao-icon.png"
                      LogicalName="MaoLauncher.Setup.mao-icon.png" />
  </ItemGroup>
</Project>
